{
  "manifest_version": 3,
  "name": "Reelsy",
  "version": "1.1.0",
  "description": "Enhances Instagram Reels with precision seek bars, frame-by-frame controls, and a premium UI.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.instagram.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "style.css"
      ],
      "run_at": "document_idle"
    }
  ]
}